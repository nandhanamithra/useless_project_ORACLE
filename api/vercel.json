{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/*.py": {
      "includeFiles": "logo1.png"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/predict",
      "destination": "/api/index.py"
    }
  ]
}